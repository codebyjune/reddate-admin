# 服务端口
PORT=3000

# JWT 签名密钥；生产环境务必改为足够长的随机字符串
JWT_SECRET=please-change-me-to-a-random-string

# PostgreSQL 连接串（数据库需启用 vector 扩展）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/reddate

# DeepSeek API Key（启用 AI 对话）
DEEPSEEK_API_KEY=

# SiliconFlow API Key（启用知识库 PDF 解析与向量检索）
SILICONFLOW_API_KEY=
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
